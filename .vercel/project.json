name: Deploy to Vercel (Smart Mode)

on:
  push:
    branches:
      - main

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v3

      - name: Setup Node
        uses: actions/setup-node@v3
        with:
          node-version: 18

      - name: Install Dependencies
        run: npm install

      - name: Run Tests
        run: npm test

      - name: Extract Vercel Org & Project ID
        id: vercel_ids
        run: |
          ORG_ID=$(jq -r .orgId .vercel/project.json)
          PROJECT_ID=$(jq -r .projectId .vercel/project.json)
          echo "ORG_ID=$ORG_ID" >> $GITHUB_ENV
          echo "PROJECT_ID=$PROJECT_ID" >> $GITHUB_ENV

      - name: Deploy to Vercel
        if: success()
        run: |
          npm install -g vercel
          vercel --prod \
            --token ${{ secrets.VERCEL_TOKEN }} \
            --confirm \
            --org $ORG_ID \
            --project $PROJECT_ID
